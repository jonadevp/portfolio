---

interface Props {
  label: string;
  href: string;
  class?: string;
  ariaLabel?: string;
}

const { label, href, class: classname, ariaLabel } = Astro.props;
---

<a 
 class={`inline-flex items-center gap-x-2 justify-center py-2 px-4 rounded-md shadow text-sm transition hover:scale-105 active:scale-95 ${classname || "text-white bg-blue-600 hover:bg-blue-700"}`} 
 href={href} 
 rel="noopener noreferrer"
 aria-label={ariaLabel}
 target="_blank"
 >
  {Astro.slots.has("icon-left") && <slot name="icon-left" />}

  <span>{label}</span>

  {Astro.slots.has("icon-right") && <slot name="icon-right" />}
</a>
