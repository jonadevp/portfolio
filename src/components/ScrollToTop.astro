<button
  type="button"
  aria-label="Volver arriba"
  id="scroll-to-top"
  class="fixed bottom-6 right-6 z-50 rounded-full bg-slate-900 text-white dark:bg-slate-900 dark:text-blue-400 p-2 shadow-lg transition-opacity duration-300 opacity-0 invisible cursor-pointer"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 56 56"
    class="pointer-events-none absolute inset-0 size-full -rotate-90"
  >
    <circle
      cx="28"
      cy="28"
      r="26"
      fill="none"
      stroke="currentColor"
      stroke-opacity="0.25"
      stroke-width="3"></circle>
    <circle
      id="scroll-progress"
      cx="28"
      cy="28"
      r="26"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      pathLength="100"
      stroke-dasharray="100"
      stroke-dashoffset="100"></circle>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    class="size-4"
    viewBox="0 0 24 24"
    ><path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18"></path></svg
  >
</button>

<script>
  let controller: AbortController | undefined;

  function initScrollButton() {
    const button = document.getElementById("scroll-to-top");
    const ring = document.getElementById("scroll-progress");
    if (!button) return;

    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const toggleButton = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(window.scrollY / max, 1) * 100 : 0;

      if (ring) ring.style.strokeDashoffset = String(100 - progress);
    
      if (window.scrollY > 300) {
        button.classList.remove("opacity-0", "invisible");
        button.classList.add("opacity-100", "visible");
      } else {
        button.classList.add("opacity-0", "invisible");
        button.classList.remove("opacity-100", "visible");
      }
    };

    const scrollToTop = () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
      });
    };

    window.addEventListener("scroll", toggleButton, { signal, passive: true });
    button.addEventListener("click", scrollToTop, { signal });
    toggleButton();
  }

  document.addEventListener("astro:page-load", initScrollButton);
</script>