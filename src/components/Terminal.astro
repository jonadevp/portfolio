<script>
  let controller: AbortController | undefined;

  const sleep = (ms: number, signal: AbortSignal): Promise<void> =>
    new Promise<void>((resolve, reject) => {
      if (signal.aborted) return reject(signal.reason);
      const t = setTimeout(resolve, ms);
      signal.addEventListener(
        "abort",
        () => {
          clearTimeout(t);
          reject(signal.reason);
        },
        { once: true },
      );
    });

  async function typeText(
    el: HTMLElement,
    text: string,
    signal: AbortSignal,
  ): Promise<void> {
    let typed = "";
    el.textContent = "";
    for (const ch of text) {
      typed += ch;
      el.textContent = typed;
      await sleep(95 + Math.random() * 50, signal);
    }
  }

  async function runTerminal(
    screen: HTMLElement,
    signal: AbortSignal,
  ): Promise<void> {
    const lines = [...screen.querySelectorAll<HTMLElement>(".term-line")];
    const cmdEls = [...screen.querySelectorAll<HTMLElement>(".term-cmd")];
    const outputs = [...screen.querySelectorAll<HTMLElement>(".term-output")];
    const cursor = screen.querySelector<HTMLElement>(".term-cursor");

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cmdEls.forEach((el) => {
        el.textContent = el.dataset.cmd ?? "";
      });
      [...lines, ...outputs].forEach((el) => {
        el.hidden = false;
      });
      const last = lines.at(-1);
      if (cursor && last) last.appendChild(cursor);
      cursor?.classList.add("terminal-blink");
      return;
    }

    try {
      while (true) {
        cmdEls.forEach((el) => {
          el.textContent = "";
        });
        [...lines, ...outputs].forEach((el) => {
          el.hidden = true;
        });
        cursor?.classList.remove("terminal-blink");
        screen.scrollTop = 0;

        for (const [i, cmdEl] of cmdEls.entries()) {
          const line = lines[i];
          const output = outputs[i];
          if (line) line.hidden = false;
          if (cursor && line) line.appendChild(cursor);
          screen.scrollTop = screen.scrollHeight;
          await typeText(cmdEl, cmdEl.dataset.cmd ?? "", signal);
          await sleep(350, signal);
          if (output) output.hidden = false;
          screen.scrollTop = screen.scrollHeight;
          await sleep(600, signal);
        }

        cursor?.classList.add("terminal-blink");
        await sleep(6000, signal);
      }
    } catch (e) {
      if (!(e instanceof DOMException && e.name === "AbortError")) throw e;
    }
  }

  function init(): void {
    const screen = document.getElementById("terminal-screen");
    if (!screen) return;
    controller?.abort();
    controller = new AbortController();
    void runTerminal(screen, controller.signal);
  }

  document.addEventListener("astro:before-swap", () => controller?.abort());
  document.addEventListener("astro:page-load", init);
  init();
</script>

<style is:inline>
  .terminal-blink {
    animation: terminal-blink 1s step-end infinite;
  }
  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }
</style>