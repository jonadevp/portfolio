---
import type { Project } from "@/types/projects";
import BadgeTech from "@components/BadgeTech.astro";
import ButtonLink from "@components/ButtonLink.astro";

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;
---

<article
  class={`relative dark:bg-linear-to-bl bg-gray-50 dark:bg-transparent dark:from-slate-600/20 dark:to-indigo-900/20 flex flex-col lg:flex-row gap-4 overflow-hidden rounded-xl backdrop-blur-xl border border-slate-200/50 dark:border-slate-700/20 p-4 shadow-sm col-span-10 group hover:shadow-lg transition-shadow ${className ?? ""}`}
>
  {
    project.thumbnail_img ? (
      <div
        style={`background-image: url('${project.thumbnail_img}')`}
        class="shrink-0 order-2 lg:order-1 w-full lg:w-100 aspect-3/2 rounded-2xl overflow-hidden mx-auto bg-cover bg-center bg-no-repeat opacity-80 bg-blend-luminosity mask-b-from-85% mask-b-to-100%"
      />
    ) : project.thumbnail_icon ? (
      (() => {
        const ThumbIcon = project.thumbnail_icon.icon;
        return (
          <div class="h-52 shrink-0 order-2 lg:order-1 relative w-full lg:w-100 aspect-3/2 rounded-2xl overflow-hidden mx-auto bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/50 p-6 flex items-center justify-center">
            <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+PGNpcmNsZSBjeD0iMTAiIGN5PSIxMCIgcj0iMiIgZmlsbD0iIzYzNjZmMSIvPjwvc3ZnPg==')]" />
            <div class="relative z-10 flex gap-4 items-center">
              <ThumbIcon class="size-8 text-slate-700 dark:text-white" />
              <span class="text-2xl font-bold text-slate-700 dark:text-white text-center">
                {project.thumbnail_icon.label}
              </span>
            </div>
          </div>
        );
      })()
    ) : (
      <div class="h-52 shrink-0 order-2 lg:order-1 relative w-full lg:w-100 aspect-3/2 rounded-2xl overflow-hidden mx-auto bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700/50 p-6 flex items-center justify-center">
        <span class="text-slate-500 dark:text-slate-400 text-sm font-medium">
          Sin imagen
        </span>
      </div>
    )
  }

  <div class="relative flex-1 z-20 flex h-full flex-col justify-end gap-1 p-4 text-lg order-1 lg:order-2">
    <header class="mb-4">
      <h3 class="font-bold text-2xl text-slate-800 dark:text-white leading-tight mb-1">
        {project.title}
      </h3>
    </header>

    <div class="flex flex-wrap items-center gap-4">
      {
        project.tags.map((tag) => {
          const Icon = tag.icon;
          return (
            <BadgeTech label={tag.label}>
              <Icon slot="icon-left" class="size-4" />
            </BadgeTech>
          );
        })
      }
    </div>

    <p class="text-base text-slate-600 dark:text-slate-400">{project.description}</p>

    <footer class="mt-4">
        {project.link && <ButtonLink label="Consultar" ariaLabel="Consultar proyecto" href={project.link} />}
    </footer>
  </div>
</article>