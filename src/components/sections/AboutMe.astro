---
import SectionContainer  from "@components/SectionContainer.astro";
import SectionTitle  from "@components/SectionTitle.astro";
import InfoUser from "@icons/InfoUser.astro";
import me from "../../assets/me.webp";
---

<SectionContainer id="sobre-mi" labelledby="sobre-mi-title" class="flex items-center flex-col lg:flex-row gap-y-4 lg:gap-x-8">

    <div class="about-info [&>p]:mt-2 [&>p]:text-sm [&>p]:font-mono">
     <SectionTitle id="sobre-mi-title" title="Sobre mí">
         <InfoUser class:list={"size-8 text-slate-900 dark:text-slate-300"} slot="icon-left" />
     </SectionTitle>

     <div class="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
       <div class="space-y-4 font-mono text-slate-600 dark:text-slate-400 leading-relaxed">
       <p class="">
         Hola 👋, soy <strong class="text-indigo-600 dark:text-indigo-400">Jonathan Sánchez Rodríguez</strong>, en GitHub me encuentras como <strong class="text-indigo-600 dark:text-indigo-400">JonaDevp</strong>.
       </p>
        <p>
          Mi viaje en el desarrollo web comenzó con la curiosidad de entender cómo funcionaban las páginas de internet. Hoy en día, me especializo en el ecosistema 
          <span class="text-indigo-600 dark:text-indigo-400 font-medium"> JavaScript/TypeScript</span>, construyendo desde interfaces dinámicas hasta complejas lógicas de negocio en el servidor.
      </p>
      <p>
          Disfruto especialmente resolver problemas arquitectónicos, diseñar bases de datos eficientes y conectar diferentes servicios a través de APIs e integraciones automatizadas.
      </p>
       </div>

       <div class="relative max-w-sm w-full aspect-square mx-auto group">
        <div class="absolute -inset-1 bg-linear-to-tr from-purple-600 to-blue-400 transform -rotate-3 group-hover:rotate-0 opacity-30 group-hover:opacity-50 rounded-2xl blur"></div>
        <div class="absolute inset-0 border border-solid border-slate-300 dark:border-slate-700 rounded-2xl flex items-center justify-center transform -rotate-3 transition-transform group-hover:rotate-0 duration-300">

          <img
          decoding="async"
          class=" rounded-2xl object-cover size-full"
          src={me.src}
          alt="Jonathan Sanchez"
          width={me.width}
          height={me.height}
          loading="lazy"
          />
        </div>
 
       </div>
     </div>

    </div>

</SectionContainer>