---
import Terminal from "@components/Terminal.astro";
import Badget from "@components/Badget.astro";
import SectionContainer from "@components/SectionContainer.astro";
import ButtonLink from "@components/ButtonLink.astro";
import GitHub from "@icons/GitHub.astro";
import LinkedIn from "@icons/LinkedIn.astro";
---

<SectionContainer class="grid grid-cols-1 lg:grid-cols-12 gap-x-4 items-center">
  <div class="lg:col-span-6 flex flex-col items-start">
    <Badget title="Disponible" />
    <h1 class="text-4xl lg:text-6xl font-bold">
      Construyendo <span
        class="bg-clip-text text-transparent bg-linear-to-r from-indigo-600 via-blue-500 to-purple-600"
      >
        experiencias tecnologicas unicas</span>
    </h1>
    <p class="text-slate-600 dark:text-slate-400 lg:pt-4">
      Desarrollador Full-Stack con más de 3 años de experiencia construyendo
      soluciones web escalables con React/Next.js. Traduzco requerimientos de
      negocio en código eficiente, con un conocimiento profundo del comercio
      electrónico multicanal.
    </p>
    <div class="my-4 lg:mt-4 flex flex-wrap items-center gap-4">
      <ButtonLink
        label="Github"
        href="https://github.com/jonadevp"
        ariaLabel="GitHub de Jonathan"
        class="text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-500/30"
      >
        <GitHub slot="icon-left" />
      </ButtonLink>

      <ButtonLink
        label="LinkedIn"
        href="https://linkedin.com/in/jonadevp"
        ariaLabel="LinkedIn de Jonathan "
        class="text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-500/30"
      >
       <LinkedIn slot="icon-left" />
      </ButtonLink>
    </div>
  </div>

  <div class="lg:col-span-6 w-full">
    <Terminal />
  </div>
</SectionContainer>
