---
import SectionContainer from "@components/SectionContainer.astro";
import SectionTitle from "@components/SectionTitle.astro";
import User from "@icons/User.astro";
import { TURNSTILE_SITE_KEY } from "astro:env/client";
import {
  NAME_MAX_LENGTH,
  EMAIL_MAX_LENGTH,
  MESSAGE_MAX_LENGTH,
} from "@/constants/contact";
---

<SectionContainer id="contacto" labelledby="contacto-title" class="max-w-2xl mx-auto">
  <div class="flex flex-col items-center">
    <p class="font-mono text-primary-600 dark:text-primary-500 mb-2 text-sm">
      ¿Qué sigue?
    </p>
    <SectionTitle id="contacto-title" title="Ponte en contacto">
      <User
        class:list={"size-8 text-slate-900 dark:text-slate-300"}
        slot="icon-left"
      />
    </SectionTitle>
  </div>

  <div class="mt-4">
    <p class="text-slate-600 dark:text-slate-400 mb-10">
      Actualmente estoy abierto a nuevas oportunidades. Si tienes una pregunta o
      simplemente quieres saludar, ¡haré todo lo posible para responderte!
    </p>

    <form id="contact-form" novalidate autocomplete="off">
      <div class="mb-5">
        <label
          for="fullname"
          class="block text-left text-slate-700 dark:text-slate-300 mb-2.5 text-sm font-medium text-heading"
        >
          Nombre completo
        </label>
        <input
          id="fullname"
          type="text"
          name="fullname"
          aria-describedby="fullname-error"
          class="bg-white dark:bg-slate-900/20 aria-invalid:border-red-500 aria-invalid:focus:ring-red-500 dark:aria-invalid:border-red-400 focus:outline-0 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition border border-slate-300 dark:border-slate-500/30 text-heading text-sm rounded-lg block w-full px-4 py-2 shadow-xs placeholder:text-body"
          placeholder="indica tu nombre"
          maxlength={NAME_MAX_LENGTH}
          required
        />
        <span
          id="fullname-error"
          class="text-xs block text-left mt-1 min-h-5 text-red-700 dark:text-red-300 font-medium"
        ></span>
      </div>

      <div class="mb-5">
        <label
          for="email"
          class="block text-left text-slate-700 dark:text-slate-300 mb-2.5 text-sm font-medium text-heading"
        >
          Email
        </label>
        <input
          inputmode="email"
          type="email"
          id="email"
          name="email"
          aria-describedby="email-error"
          class="bg-white dark:bg-slate-900/20 aria-invalid:border-red-500 aria-invalid:focus:ring-red-500 dark:aria-invalid:border-red-400 focus:outline-0 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition border border-slate-300 dark:border-slate-500/30 text-heading text-sm rounded-lg block w-full px-4 py-2 shadow-xs placeholder:text-body"
          placeholder="example@gmail.com"
          maxlength={EMAIL_MAX_LENGTH}
          required
        />
        <span
          id="email-error"
          class="text-xs block text-left mt-1 min-h-5 text-red-700 dark:text-red-300 font-medium"
        ></span>
      </div>

      <div class="mb-5">
        <label
          for="message"
          class="block text-left text-slate-700 dark:text-slate-300 mb-2.5 text-sm font-medium text-heading"
        >
          Mensaje
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          aria-describedby="message-error"
          class="bg-white dark:bg-slate-900/20 aria-invalid:border-red-500 aria-invalid:focus:ring-red-500 dark:aria-invalid:border-red-400 resize-none focus:outline-0 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition border border-slate-300 dark:border-slate-500/30 text-heading text-sm rounded-lg block w-full px-4 py-2 shadow-xs placeholder:text-body"
          placeholder="Tu mensaje"
          maxlength={MESSAGE_MAX_LENGTH}
          required></textarea>

        <div class="flex items-center justify-between mt-1">
          <span
            id="message-error"
            class="text-xs block text-left min-h-5 text-red-700 dark:text-red-300 font-medium"
          ></span>

          <span
            id="count-characters-msg"
            class="text-xs pr-4 text-slate-600 dark:text-slate-400"
            >0/{MESSAGE_MAX_LENGTH}</span
          >
        </div>
      </div>

      <div
        id="turnstile-box"
        class="cf-turnstile mb-5 flex items-center justify-center"
        data-sitekey={TURNSTILE_SITE_KEY}
        data-appearance="interaction-only"
        data-language="es"
      >
      </div>

      <button
        type="submit"
        class="bg-indigo-800 mx-auto max-w-xl w-full flex items-center justify-center gap-x-2 text-white transition hover:scale-105 active:scale-95 px-4 py-2 text-sm cursor-pointer rounded-lg font-medium disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:scale-100"
      >
        Contactar
        <svg
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-4 -rotate-45"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
          ></path>
        </svg>
      </button>

      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="mb-4 min-h-6 text-sm text-slate-600 dark:text-slate-300"
      >
      </p>
    </form>
  </div>
</SectionContainer>

<script>
  import { actions, isInputError } from "astro:actions";
  import confetti from "canvas-confetti";
  import { sileo } from "sileo";
  import { toastColors } from "@/types/toast-type";
  import { MESSAGE_MAX_LENGTH } from "@/constants/contact";

  let controller: AbortController | undefined;

  function initContactForm() {
    const FIELDS = ["fullname", "email", "message"] as const;

    type TurnstileApi = { reset: (target?: string) => void };

    const resetTurnstile = () => {
      (window as unknown as { turnstile?: TurnstileApi }).turnstile?.reset(
        "#turnstile-box",
      );
    };

    const form = document.getElementById("contact-form");
    const statusEl = document.getElementById("form-status");

    if (!(form instanceof HTMLFormElement) || !statusEl) return;

    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );

    const messageEl = document.getElementById("message");
    const counterEl = document.getElementById("count-characters-msg");

    const updateCounter = () => {
      if (messageEl instanceof HTMLTextAreaElement && counterEl) {
        counterEl.textContent = `${messageEl.value.length}/${MESSAGE_MAX_LENGTH}`;
      }
    };

    messageEl?.addEventListener("input", updateCounter, { signal });

    const clearErrors = () => {
      statusEl.textContent = "";
      for (const name of FIELDS) {
        const errorEl = document.getElementById(`${name}-error`);
        if (errorEl) errorEl.textContent = "";
        document.getElementById(name)?.removeAttribute("aria-invalid");
      }
    };

    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();
        clearErrors();
        if (button) button.disabled = true;

        try {
          const { error } = await actions.sendEmail(new FormData(form));

          if (error) {
            if (isInputError(error)) {
              let shown = false;
              for (const name of FIELDS) {
                const messages = error.fields[name];
                if (!messages) continue;
                const errorEl = document.getElementById(`${name}-error`);
                if (errorEl) errorEl.textContent = messages[0] ?? "";
                document
                  .getElementById(name)
                  ?.setAttribute("aria-invalid", "true");
                shown = true;
              }
              if (!shown) {
                sileo.warning({
                  title: "Aviso",
                  description: "Completa la verificación e inténtalo de nuevo",
                  ...toastColors("warning"),
                });
              }
              return;
            }
            // Nunca se muestra error.message: ante un 429 de Netlify traería
            // el cuerpo crudo de su respuesta, que puede ser una página entera.
            if (error.code === "TOO_MANY_REQUESTS") {
              sileo.warning({
                title: "Demasiados intentos",
                description:
                  "Has enviado varios mensajes seguidos. Espera unos minutos e inténtalo de nuevo.",
                ...toastColors("warning"),
              });
            } else if (error.code === "BAD_REQUEST") {
              sileo.warning({
                title: "Verificación",
                description:
                  "No se pudo verificar que eres una persona. Inténtalo de nuevo.",
                ...toastColors("warning"),
              });
            } else if (error.code === "SERVICE_UNAVAILABLE") {
              sileo.error({
                title: "Servicio no disponible",
                description:
                  "De momento no puedo recibir más correos. Inténtalo más tarde.",
                ...toastColors("error"),
              });
            } else {
              sileo.error({
                title: "Algo salió mal",
                description:
                  "No se pudo enviar el mensaje. Espera un minuto e inténtalo de nuevo; si el problema continúa, escríbeme a contacto@jonadevp.com.",
                ...toastColors("error"),
              });
            }
            return;
          }

          confetti({
            particleCount: 120,
            spread: 70,
            origin: { y: 0.7 },
            disableForReducedMotion: true,
          });
          sileo.success({
            title: "Mensaje enviado",
            description:
              "Gracias por tu mensaje, me pondré en contacto contigo lo mas pronto posible",
            ...toastColors("success"),
          });
          form.reset();
          updateCounter();
        } catch {
          // Aquí solo llegan los fallos de conexión: el cliente de acciones
          // no captura el rechazo del fetch.
          sileo.error({
            title: "Algo salió mal",
            description:
              "No se pudo conectar con el servidor. Revisa tu conexión e inténtalo de nuevo",
            ...toastColors("error"),
          });
        } finally {
          if (button) button.disabled = false;
          resetTurnstile();
        }
      },
      { signal },
    );

    updateCounter();
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>
