---
import SectionContainer from "@components/SectionContainer.astro";
import SectionTitle from "@components/SectionTitle.astro";
import User from "@icons/User.astro";
import { TURNSTILE_SITE_KEY } from "astro:env/client";
---

<SectionContainer id="contacto" class="mx-auto text-center">
  <SectionTitle title="Contacto" class="justify-center">
    <User
      class:list={"size-8 text-slate-900 dark:text-slate-300"}
      slot="icon-left"
    />
  </SectionTitle>

  <div class="max-w-xl mx-auto">
    <p class="font-mono text-primary-600 dark:text-primary-500 mb-2 text-sm">
      ¿Qué sigue?
    </p>
    <h2
      class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-6"
    >
      Ponte en contacto
    </h2>
    <p class="text-slate-600 dark:text-slate-400 mb-10">
      Actualmente estoy abierto a nuevas oportunidades. Si tienes una pregunta o
      simplemente quieres saludar, ¡haré todo lo posible para responderte!
    </p>

    <form id="contact-form" novalidate>
      <div class="mb-5">
        <label
          for="fullname"
          class="block text-left text-slate-700 dark:text-slate-300 mb-2.5 text-sm font-medium text-heading"
        >
          Nombre completo
        </label>
        <input
          id="fullname"
          type="text"
          name="fullname"
          aria-describedby="fullname-error"
          class="bg-slate-900/20 aria-invalid:border-red-500 aria-invalid:focus:ring-red-500 dark:aria-invalid:border-red-400 focus:outline-0 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition border border-slate-200 dark:border-slate-500/30 text-heading text-sm rounded-lg block w-full px-4 py-2 shadow-xs placeholder:text-body"
          placeholder="indica tu nombre"
          required
        />
        <span
          id="fullname-error"
          class="text-xs block text-left mt-1 min-h-5 text-red-700 dark:text-red-300 font-medium"
        ></span>
      </div>

      <div class="mb-5">
        <label
          for="email"
          class="block text-left text-slate-700 dark:text-slate-300 mb-2.5 text-sm font-medium text-heading"
        >
          Email
        </label>
        <input
          inputmode="email"
          type="email"
          id="email"
          name="email"
          aria-describedby="email-error"
          class="bg-slate-900/20 aria-invalid:border-red-500 aria-invalid:focus:ring-red-500 dark:aria-invalid:border-red-400 focus:outline-0 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition border border-slate-200 dark:border-slate-500/30 text-heading text-sm rounded-lg block w-full px-4 py-2 shadow-xs placeholder:text-body"
          placeholder="example@gmail.com"
          required
        />
        <span
          id="email-error"
          class="text-xs block text-left mt-1 min-h-5 text-red-700 dark:text-red-300 font-medium"
        ></span>
      </div>

      <div class="mb-5">
        <label
          for="message"
          class="block text-left text-slate-700 dark:text-slate-300 mb-2.5 text-sm font-medium text-heading"
        >
          Mensaje
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          aria-describedby="message-error"
          class="bg-slate-900/20 aria-invalid:border-red-500 aria-invalid:focus:ring-red-500 dark:aria-invalid:border-red-400 resize-none focus:outline-0 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition border border-slate-200 dark:border-slate-500/30 text-heading text-sm rounded-lg block w-full px-4 py-2 shadow-xs placeholder:text-body"
          placeholder="Tu mensaje"
          required></textarea>
        <span
          id="message-error"
          class="text-xs block text-left mt-1 min-h-5 text-red-700 dark:text-red-300 font-medium"
        ></span>
      </div>

      <div
        id="turnstile-box"
        class="cf-turnstile"
        data-sitekey={TURNSTILE_SITE_KEY}
        data-appearance="interaction-only"
        data-language="es"
      >
      </div>

      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="mb-4 min-h-6 text-sm text-slate-600 dark:text-slate-300"
      >
      </p>

      <button
        type="submit"
        class="bg-indigo-800 text-white transition hover:scale-105 active:scale-95 px-4 py-1.5 text-sm cursor-pointer rounded-lg font-medium disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:scale-100"
      >
        Contactar
      </button>
    </form>
  </div>
</SectionContainer>

<script>
  import { actions, isInputError } from "astro:actions";
  import confetti from "canvas-confetti";

  const FIELDS = ["fullname", "email", "message"] as const;

  type TurnstileApi = { reset: (target?: string) => void };

  const resetTurnstile = () => {
    (window as unknown as { turnstile?: TurnstileApi }).turnstile?.reset(
      "#turnstile-box",
    );
  };

  const form = document.getElementById("contact-form");
  const statusEl = document.getElementById("form-status");

  if (form instanceof HTMLFormElement && statusEl) {
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );

    const clearErrors = () => {
      statusEl.textContent = "";
      for (const name of FIELDS) {
        const errorEl = document.getElementById(`${name}-error`);
        if (errorEl) errorEl.textContent = "";
        document.getElementById(name)?.removeAttribute("aria-invalid");
      }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearErrors();
      if (button) button.disabled = true;

      try {
        const { error } = await actions.sendEmail(new FormData(form));

        if (error) {
          if (isInputError(error)) {
            let shown = false;
            for (const name of FIELDS) {
              const messages = error.fields[name];
              if (!messages) continue;
              const errorEl = document.getElementById(`${name}-error`);
              if (errorEl) errorEl.textContent = messages.join(" ");
              document
                .getElementById(name)
                ?.setAttribute("aria-invalid", "true");
              shown = true;
            }
            if (!shown) {
              statusEl.textContent =
                "Completa la verificación e inténtalo de nuevo.";
            }
            return;
          }

          // Nunca se muestra error.message: ante un 429 de Netlify traería
          // el cuerpo crudo de su respuesta, que puede ser una página entera.
          statusEl.textContent =
            error.code === "BAD_REQUEST"
              ? "No se pudo verificar que eres una persona. Inténtalo de nuevo."
              : "No se pudo enviar el mensaje. Espera un minuto e inténtalo de nuevo; si el problema continúa, escríbeme a contacto@jonadevp.com.";
          return;
        }

        statusEl.textContent = "Mensaje enviado. Te responderé pronto.";
        confetti({
          particleCount: 120,
          spread: 70,
          origin: { y: 0.7 },
          disableForReducedMotion: true,
        });
        form.reset();
      } catch {
        // Aquí solo llegan los fallos de conexión: el cliente de acciones
        // no captura el rechazo del fetch.
        statusEl.textContent =
          "No se pudo conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.";
      } finally {
        if (button) button.disabled = false;
        resetTurnstile();
      }
    });
  }
</script>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>