---
import SectionContainer from "@components/SectionContainer.astro";
import SectionTitle from "@components/SectionTitle.astro";
import BadgeTech from "@components/BadgeTech.astro";
import Brain from "@icons/Brain.astro";
import { skills } from "@data/cv.json";
import { findTag } from "@/types/tags";
---

<SectionContainer id="skills" labelledby="skills-title">
  <SectionTitle id="skills-title" title="Skills & herramientas">
    <Brain class="size-8 text-slate-900 dark:text-slate-300" slot="icon-left" />
  </SectionTitle>

  <ul class="space-y-4 mt-4 list-disc">
    {
      skills.map((skill) => (
        <li>
          <h3 class="text-lg font-bold text-slate-700 dark:text-white">
            {skill.name}
          </h3>

          <ul class="flex flex-wrap gap-2 mt-2 list-none">
            {skill.keywords.map((key) => {
              const tag = findTag(key);
              return (
                <li>
                  <BadgeTech label={key}>
                    {tag && <tag.icon slot="icon-left" class="size-4" />}
                  </BadgeTech>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ul>
</SectionContainer>