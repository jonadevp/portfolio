---
const THEMES = ["Light", "Dark", "System"];
---

<>
  <button
    transition:persist
    type="button"
    id="theme-toggle-btn"
    class="appearance-none border-none flex hover:scale-125 transition text-slate-700 dark:text-white/90"
  >
    <span class="sr-only">Elige un tema</span>
    <!-- Sun icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      id="light"
      class="size-6 theme-icon"
      viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0"
      ></path></svg
    >
    <!-- System icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      id="system"
      class="size-6 theme-icon absolute"
      viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"
      ></path></svg
    >
    <!-- Moon icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      id="dark"
      class="size-6 theme-icon absolute"
      viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21.752 15.002A9.7 9.7 0 0 1 18 15.75 9.75 9.75 0 0 1 8.25 6c0-1.33.266-2.597.748-3.752A9.75 9.75 0 0 0 3 11.25 9.75 9.75 0 0 0 12.75 21a9.75 9.75 0 0 0 9.002-5.998"
      ></path></svg
    >
  </button>

  <div
    transition:persist
    id="themes-menu"
    class="absolute top-full right-0 hidden text-sm p-1 max-w-[calc(100vw-2rem)] w-56 rounded-md shadow bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-500/20 backdrop-blur-md"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li class="themes-menu-option cursor-default z-50 px-2 py-1.5 hover:bg-slate-400/40 dark:hover:bg-gray-500/50 rounded-sm">
            {theme}
          </li>
        ))
      }
    </ul>
  </div>
</>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  type ThemePreference = "dark" | "light" | "system";

  const DARK: ThemePreference = "dark";
  const LIGHT: ThemePreference = "light";
  const SYSTEM: ThemePreference = "system";
  const THEME_STORAGE_KEY = "theme";

  let remove: (() => void) | null = null;
  //detecta la preferencia de colores de tu sistema operativo
  const matchMedia = window.matchMedia("(prefers-color-scheme: dark)");
  const themesMenu = document.getElementById("themes-menu") as HTMLDivElement;

  const getThemePreference = (): ThemePreference => {
    if (typeof localStorage !== "undefined") {
      return (
        (localStorage.getItem(THEME_STORAGE_KEY) as ThemePreference) ?? SYSTEM
      );
    }
    return matchMedia.matches ? DARK : LIGHT;
  };

  const updateIcon = (themePreference: ThemePreference): void => {
    document.querySelectorAll<HTMLElement>(".theme-icon").forEach((element) => {
      element.style.scale = element.id === themePreference ? "1" : "0";
    });
  };

  const updateTheme = (): void => {
    if (remove != null) {
      remove();
    }

    matchMedia.addEventListener("change", updateTheme);
    remove = () => {
      matchMedia.removeEventListener("change", updateTheme);
    };

    const themePreference = getThemePreference();
    const isDark =
      themePreference === DARK ||
      (themePreference === SYSTEM && matchMedia.matches);

    updateIcon(themePreference);
    document.documentElement.classList.toggle("dark", isDark);
  };

  updateTheme();

  let abortController: AbortController | null = null;

  const attachListeners = () => {
    abortController?.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    document.addEventListener(
      "click",
      () => themesMenu.classList.remove("open"),
      { signal },
    );

    document.getElementById("theme-toggle-btn")?.addEventListener(
      "click",
      (e) => {
        e.stopPropagation();
        const isClosed = !themesMenu.classList.contains("open");
        themesMenu.classList.toggle("open", isClosed);
        if (isClosed) {
          const nav = document.getElementById("navbar");
          const toggleMenu = document.getElementById("toggle-menu");
          if (nav) nav.dataset.open = "false";
          toggleMenu?.setAttribute("aria-expanded", "false");
        }
      },
      { signal },
    );

    document
      .querySelectorAll<HTMLLIElement>(".themes-menu-option")
      .forEach((element) => {
        element.addEventListener(
          "click",
          (e) => {
            const target = e.target as HTMLElement;
            const theme = target.innerText
              .toLowerCase()
              .trim() as ThemePreference;
            localStorage.setItem(THEME_STORAGE_KEY, theme);
            updateTheme();
          },
          { signal },
        );
      });
  };

  attachListeners();

  document.addEventListener("astro:after-swap", () => {
    updateTheme();
    attachListeners();
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });
  });
</script>
