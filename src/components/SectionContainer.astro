---
interface Props {
    id?: string;
    class?: string;
    labelledby?: string;
}

const { class: className, id, labelledby } = Astro.props;
---

<section id={id} aria-labelledby={labelledby} class:list={['section-container px-3 scroll-m-20 mx-auto w-full pt-20', className]}>
    <slot />
</section>
